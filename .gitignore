.DS_Store

# Local secrets and runtime configuration
config.json
.env
.env.*
.envrc

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Node / Vite
frontend/node_modules/
frontend/dist/

# Local runtime data
models_cache/
uploads/
logs/
*.log

# Media files may contain private recordings
*.mp3
*.wav
*.m4a
*.mp4
*.mov
*.ogg
*.opus
*.webm

# CCE (code-context-engine)
# CCE local cache (per-machine, not for version control)
.cce/
# Claude Code local settings written by cce init
.claude/
# .mcp.json contains absolute paths regenerated by `cce init`
.mcp.json
